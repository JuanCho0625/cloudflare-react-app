/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-react-app",
	"compatibility_date": "2026-09-16",
	"workers_dev": true,
	/**
	 * Static Assets: sirve el build de Vite (dist/) desde el Worker.
	 * "single-page-application" hace que cualquier ruta desconocida
	 * devuelva index.html, que es lo que necesita una SPA de React.
	 * https://developers.cloudflare.com/workers/static-assets/
	 */
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
